# Скопируйте этот файл в .env и заполните значения: cp .env.example .env
# Сам .env в репозиторий не коммитим.

# База данных (совпадает с настройками сервиса db в docker-compose.yml)
POSTGRES_USER=bytearena
POSTGRES_PASSWORD=bytearena
POSTGRES_DB=bytearena
DATABASE_URL=postgresql+psycopg://bytearena:bytearena@db:5432/bytearena

# Вход через Discord (discord.com/developers → ваше приложение → OAuth2)
DISCORD_CLIENT_ID=46807967857564534
DISCORD_CLIENT_SECRET=i34jtyg786t9уGhyF6u5EVrBymu7tV76RBfO
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# JWT: замените значение на уникальный случайный секрет
JWT_SECRET=7be2ae4464f6d0225097cd81b70a404f020627584c5f022b99e1ffbe4f441056
JWT_ALGORITHM=HS256

# Только локально для временного POST /api/auth/debug-login/{user_id}; в production оставить false
DEBUG_AUTH_ENABLED=false
# Для локального HTTP укажите false; в production используйте HTTPS и оставьте true
COOKIE_SECURE=false

# Фронтенд: true — ответы API подменяются моками (MSW), false — настоящий бэкенд
NEXT_PUBLIC_API_MOCKS=true
